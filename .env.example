# Copy to .env and adjust for your local AVD / APK path.
# .env is gitignored — never commit real device-specific secrets here.

# AVD name from `emulator -list-avds`, or adb device name
ANDROID_DEVICE_NAME=Pixel_7_API_34

# Android OS version on the emulator (e.g. 14.0, 15.0)
ANDROID_PLATFORM_VERSION=14.0

# Path to Sauce Labs My Demo App APK (relative to repo root or absolute)
APP_PATH=./apps/android/mda-2.2.0-25.apk
