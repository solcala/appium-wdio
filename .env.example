# Copy to .env and adjust for your local devices / app paths.
# .env is gitignored — never commit device-specific secrets here.

# --- Android emulator ---
# AVD name from `emulator -list-avds`, or adb device name
ANDROID_DEVICE_NAME=Pixel_7_API_34

# Android OS version on the emulator (e.g. 14.0, 15.0, 16)
ANDROID_PLATFORM_VERSION=14.0

# Path to Sauce Labs My Demo App APK (relative to repo root or absolute)
APP_PATH=./apps/android/mda-2.2.0-25.apk

# --- iOS Simulator ---
# Simulator name from `xcrun simctl list devices available`
# Prefer a runtime that matches your Xcode Simulator SDK (xcodebuild -showsdks)
IOS_DEVICE_NAME=iPhone 17

# iOS version on the simulator (e.g. 18.6, 26.5)
IOS_PLATFORM_VERSION=26.5

# Path to Sauce Labs My Demo App Simulator .app (unzip SauceLabs-Demo-App.Simulator.zip)
IOS_APP_PATH=./apps/ios/Payload/My Demo App.app

# --- Test data (optional) ---
# Seed for @faker-js/faker checkout factories (address/payment). Omit for fresh random data each run.
# TEST_DATA_SEED=42
